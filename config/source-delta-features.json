{
  "schemaVersion": 1,
  "policy": "independent-gameplay-bundles",
  "description": "Gameplay behavior is preserved as exact source blobs in a manager-owned feature namespace. Common upstream files are not overwritten by these bundles. Runtime use requires a manager adapter and interface regression tests; staging alone is not activation.",
  "bundles": [
    {
      "id": "rescue-revival",
      "profile": "stronghold-server",
      "name": "救援/复活",
      "sourcePaths": [],
      "integrationPoints": [
        "server/match/match/combat.js",
        "server/sim/Battle.js",
        "server/sim/content/items/battle.js",
        "server/sim/content/bands/battle.js",
        "server/sim/content/bonds/addon/battle.js",
        "server/sim/content/kits/ops/chess_char_2_12-gravel.js",
        "server/sim/content/kits/ops/chess_char_3_04-swire2.js",
        "server/sim/content/kits/ops/chess_char_5_05-ulpia.js",
        "server/match/Match.js",
        "shared/protocol.js"
      ],
      "activationStatus": "adapter-required",
      "rationale": "复活语义并非一个独立文件：items/battle.js 定义 reviveNow/死亡与立即免费再部署优先级，bands/battle.js 处理埃芒加德复活，bonds/addon/battle.js 处理不屈，Swire2/乌尔比安等干员模块又包含专属费用/落点规则；Battle.js 是底层死亡/部署时序，combat.js 还确保 synthetic 结果不能冒充真实救援资格。以上都是混合多种游戏行为的共享文件，所以目前只原样写入 references，不冒充独立功能模块。需从这些钩子提取窄接口的 Forge revive/rescue adapter，并把资格、优先级、费用、SP、部署事件和落点回归后，才能启用。",
      "referencePaths": [
        "server/match/match/combat.js",
        "server/sim/Battle.js",
        "server/sim/content/items/battle.js",
        "server/sim/content/bands/battle.js",
        "server/sim/content/bonds/addon/battle.js",
        "server/sim/content/kits/ops/chess_char_2_12-gravel.js",
        "server/sim/content/kits/ops/chess_char_3_04-swire2.js",
        "server/sim/content/kits/ops/chess_char_5_05-ulpia.js"
      ]
    },
    {
      "id": "unite-second-relay",
      "profile": "stronghold-server",
      "name": "联防二段接力",
      "sourcePaths": [
        "server/match/unite.js",
        "server/match/match/unitePhase.js"
      ],
      "integrationPoints": [
        "server/match/unite.js",
        "server/match/match/unitePhase.js",
        "server/match/match/settle.js",
        "shared/protocol.js"
      ],
      "activationStatus": "adapter-required",
      "rationale": "联防规则与 UNITE 阶段本身有独立源码模块，可单独保存；结算奖励/结果 view 仍与公共 settle.js 交织，所以 settle.js 只作为原始参考 blob 留存，运行时不整文件替换。",
      "referencePaths": [
        "server/match/match/settle.js"
      ]
    },
    {
      "id": "freeze-when-all-humans-offline",
      "profile": "stronghold-server-server-agent",
      "name": "全员离线冻结对局",
      "sourcePaths": [
        "server/match/match/frozen.js"
      ],
      "integrationPoints": [
        "server/lobby.js",
        "server/match/match/frozen.js",
        "server/match/Match.js"
      ],
      "activationStatus": "adapter-required",
      "rationale": "冻结计时与恢复的 Match 方法独立保存在 frozen.js；agent 版 server/lobby.js 是共享房间生命周期文件，仅作为参考 blob 保存，由适配器挂入重连/房间清理流程，不覆盖上游大厅。",
      "referencePaths": [
        "server/lobby.js"
      ]
    },
    {
      "id": "host-browser-ai-rehearsal",
      "profile": "stronghold-server-server-agent",
      "name": "房主浏览器代算 AI 布阵",
      "sourcePaths": [
        "public/js/battle/rehearsal.js",
        "public/js/battle/rehearsalWorker.js",
        "server/match/match/rehearsal.js",
        "server/sim/rehearsal.js"
      ],
      "integrationPoints": [
        "public/js/main.js",
        "public/js/battle/rehearsal.js",
        "public/js/battle/rehearsalWorker.js",
        "server/match/Match.js",
        "server/match/match/prep.js",
        "server/match/match/rehearsal.js",
        "server/sim/rehearsal.js",
        "server/lobby.js",
        "server/index.js",
        "shared/protocol.js"
      ],
      "activationStatus": "adapter-required",
      "rationale": "完整功能切片包含浏览器安装模块 rehearsal.js、module Worker rehearsalWorker.js、服务器/浏览器共用的纯模拟与评分 server/sim/rehearsal.js，以及服务器侧 MatchRehearsal。public/js/main.js、prep.js、lobby.js、Match.js、index.js 只作为当前来源接线的参考快照，由 Forge 针对上游新入口适配；worker 的运行时路径和请求/响应协议必须双端验收。",
      "referencePaths": [
        "public/js/main.js",
        "server/match/match/prep.js",
        "server/lobby.js",
        "server/index.js",
        "server/match/Match.js"
      ]
    }
  ]
}
